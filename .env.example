# Shared shopping ticks and receipts. Add an Upstash Redis database in the Vercel
# marketplace and attach it to the project — Vercel injects these two for you.
#
# Leave them unset (as in `npm run dev`) and the page falls back to per-device state:
# the API answers 503 and the client keeps everything in localStorage, as it did before.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A database made outside Vercel uses these names instead; the route accepts either.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
